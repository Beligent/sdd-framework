{
  "project": {
    "name": "{{project_name}}",
    "type": "{{project_type}}"
  },
  "assistants": [
    "codex"
  ],
  "technologies": [],
  "artifacts": {
    "overview": ".sdd/beligent/overview.md",
    "requirements": ".sdd/beligent/requirements",
    "specifications": ".sdd/beligent/specs",
    "decisions": ".sdd/beligent/architecture/decisions",
    "plans": ".sdd/beligent/plans",
    "verification": ".sdd/beligent/verification",
    "approvals": ".sdd/beligent/approvals",
    "conventions": ".sdd/beligent/guidance"
  },
  "tickets": {
    "provider": "markdown",
    "paths": {
      "epics": ".sdd/beligent/epics",
      "tickets": ".sdd/beligent/tickets"
    }
  },
  "workflow": {
    "rigor": "standard",
    "design_depth": "current-task",
    "ask_before_expansion": true
  },
  "testing": {
    "lint": "always",
    "typecheck": "always",
    "unit": "when-relevant",
    "integration": "when-relevant",
    "e2e": "critical-user-journeys",
    "accessibility": "affected-ui",
    "security": "risk-based",
    "performance": "risk-based",
    "tdd": "when-useful",
    "manual": "when-relevant"
  },
  "git": {
    "strategy": "feature-branches",
    "conventional_commits": true,
    "commit_after_task": true,
    "agent_may_commit": true,
    "push_after_commit": "ask",
    "pull_request": "feature-complete",
    "review_before_commit": true,
    "delivery_complete_at": "merged-pr"
  },
  "tracking": {
    "mode": "opt-in"
  }
}
