{
  "schema_version": 2,
  "project": {
    "name": "{{project_name}}",
    "type": "{{project_type}}"
  },
  "assistants": ["codex"],
  "profile": "standard",
  "technologies": [],
  "artifacts": {
    "overview": "docs/sdd/overview.md",
    "requirements": "docs/sdd/requirements",
    "specifications": "docs/sdd/specifications",
    "decisions": "docs/sdd/architecture/decisions",
    "plans": "docs/sdd/plans",
    "verification": "docs/sdd/verification",
    "approvals": "docs/sdd/approvals",
    "conventions": "docs/sdd/conventions"
  },
  "tickets": {
    "provider": "markdown",
    "paths": {
      "epics": "docs/sdd/epics",
      "tickets": "docs/sdd/tickets"
    }
  },
  "profiles": {
    "lightweight": {
      "artifacts": ["ticket"],
      "approvals": ["implementation", "completion"]
    },
    "standard": {
      "artifacts": ["overview", "requirements", "specification", "plan", "ticket"],
      "approvals": ["scope", "implementation", "completion"]
    }
  },
  "workflow": {
    "rigor": "standard",
    "design_depth": "current-task",
    "ask_before_expansion": true
  },
  "testing": {
    "lint": "always",
    "typecheck": "always",
    "unit": "when-relevant",
    "integration": "when-relevant",
    "e2e": "critical-user-journeys",
    "accessibility": "affected-ui",
    "security": "risk-based",
    "performance": "risk-based",
    "tdd": "when-useful",
    "manual": "when-relevant"
  },
  "git": {
    "strategy": "feature-branches",
    "conventional_commits": true,
    "commit_after_task": true,
    "agent_may_commit": true,
    "push_after_commit": "ask",
    "pull_request": "feature-complete",
    "review_before_commit": true,
    "task_complete_at": "merged-pr"
  }
}
