{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:beligent:sdd:config:schema:2",
  "title": "Beligent SDD project configuration, schema 2",
  "description": "Schema 2 adds explicit project workflow, verification, and delivery policy while retaining schema-1 artifact and profile fields for compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "assistants", "profile", "technologies", "artifacts", "tickets", "profiles", "workflow", "testing", "git"],
  "properties": {
    "schema_version": { "const": 2 },
    "project": {
      "type": "object", "additionalProperties": false, "required": ["name", "type"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 } }
    },
    "assistants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "technologies": { "type": "array", "uniqueItems": true, "items": { "enum": ["react-typescript", "nextjs", "nodejs", "python", "fastapi"] } },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["overview", "requirements", "specifications", "decisions", "plans", "verification", "approvals", "conventions"],
      "properties": {
        "overview": { "$ref": "#/$defs/path" }, "requirements": { "$ref": "#/$defs/path" },
        "specifications": { "$ref": "#/$defs/path" }, "decisions": { "$ref": "#/$defs/path" },
        "plans": { "$ref": "#/$defs/path" }, "verification": { "$ref": "#/$defs/path" },
        "approvals": { "$ref": "#/$defs/path" }, "conventions": { "$ref": "#/$defs/path" }
      }
    },
    "tickets": {
      "type": "object", "additionalProperties": false, "required": ["provider", "paths"],
      "properties": {
        "provider": { "const": "markdown" },
        "paths": { "type": "object", "additionalProperties": false, "required": ["epics", "tickets"], "properties": { "epics": { "$ref": "#/$defs/path" }, "tickets": { "$ref": "#/$defs/path" } } }
      }
    },
    "profiles": {
      "type": "object", "minProperties": 2,
      "required": ["lightweight", "standard"],
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["artifacts", "approvals"],
        "properties": {
          "artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["overview", "requirements", "specification", "adr", "epic", "ticket", "plan", "verification"] } },
          "approvals": { "type": "array", "uniqueItems": true, "items": { "enum": ["scope", "implementation", "completion"] }, "allOf": [{ "contains": { "const": "implementation" } }, { "contains": { "const": "completion" } }] }
        }
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false, "required": ["rigor", "design_depth", "ask_before_expansion"],
      "properties": {
        "rigor": { "enum": ["light", "standard", "rigorous"] },
        "design_depth": { "enum": ["current-task", "near-term", "comprehensive"] },
        "ask_before_expansion": { "type": "boolean" }
      }
    },
    "testing": {
      "type": "object", "additionalProperties": false,
      "required": ["lint", "typecheck", "unit", "integration", "e2e", "accessibility", "security", "performance", "tdd", "manual"],
      "properties": {
        "lint": { "enum": ["always", "when-relevant", "never"] },
        "typecheck": { "enum": ["always", "when-relevant", "never"] },
        "unit": { "enum": ["always", "when-relevant", "never"] },
        "integration": { "enum": ["always", "when-relevant", "never"] },
        "e2e": { "enum": ["always", "when-relevant", "critical-user-journeys", "never"] },
        "accessibility": { "enum": ["always", "when-relevant", "affected-ui", "never"] },
        "security": { "enum": ["always", "when-relevant", "risk-based", "never"] },
        "performance": { "enum": ["always", "when-relevant", "risk-based", "never"] },
        "tdd": { "enum": ["always", "when-useful", "never"] },
        "manual": { "enum": ["always", "when-relevant", "never"] }
      }
    },
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "conventional_commits", "commit_after_task", "agent_may_commit", "push_after_commit", "pull_request", "review_before_commit", "task_complete_at"],
      "properties": {
        "strategy": { "enum": ["trunk", "feature-branches"] },
        "conventional_commits": { "type": "boolean" },
        "commit_after_task": { "type": "boolean" },
        "agent_may_commit": { "type": "boolean" },
        "push_after_commit": { "enum": ["always", "ask", "never"] },
        "pull_request": { "enum": ["never", "feature-complete", "always"] },
        "review_before_commit": { "type": "boolean" },
        "task_complete_at": { "enum": ["commit", "push", "pull-request", "merged-pr"] }
      }
    }
  },
  "$defs": { "path": { "type": "string", "minLength": 1 } }
}
