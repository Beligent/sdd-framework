{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:beligent:sdd:config:v2",
  "title": "Beligent SDD project configuration (v2)",
  "description": "Project settings at .sdd/beligent/config.json. Earlier schemas are rejected, never converted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "hosts"
  ],
  "properties": {
    "schema": {
      "const": "beligent-sdd/config/v2"
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "codex",
          "claude-code",
          "github-copilot",
          "cursor",
          "devin"
        ]
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stacks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "react-typescript",
          "nextjs",
          "nodejs",
          "python",
          "fastapi"
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_for": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorization": {
          "enum": [
            "request",
            "recorded"
          ]
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/permission"
        },
        "push": {
          "$ref": "#/$defs/permission"
        },
        "pull_request": {
          "$ref": "#/$defs/permission"
        },
        "delivered_at": {
          "enum": [
            "commit",
            "push",
            "pull-request",
            "merged-pr"
          ]
        }
      }
    }
  },
  "$defs": {
    "permission": {
      "enum": [
        "allowed",
        "ask",
        "never"
      ]
    }
  }
}
