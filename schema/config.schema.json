{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:beligent:sdd:config",
  "title": "Beligent SDD project configuration",
  "description": "Project settings at .sdd/beligent/config.json. Earlier schemas are rejected, never converted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "hosts"
  ],
  "properties": {
    "schema": {
      "const": "beligent-sdd/config"
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Supported: codex, claude-code, github-copilot, github-copilot-cloud, cursor. Other names are ignored."
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stacks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "react-typescript",
          "nextjs",
          "nodejs",
          "python",
          "fastapi"
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
