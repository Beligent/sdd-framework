{
  "name": "@beligent/sdd-framework",
  "version": "1.0.3",
  "description": "A lightweight engineering playbook for AI coding assistants: define, implement, test, review and deliver changes with Agent Skills.",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/beligent/sdd-framework.git"
  },
  "homepage": "https://github.com/beligent/sdd-framework#readme",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/beligent/sdd-framework/issues"
  },
  "keywords": [
    "agent-skills",
    "specification-driven-development",
    "sdd",
    "coding-agents",
    "development-workflow"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "sdd": "dist/cli/index.js"
  },
  "files": [
    "dist/cli/index.js",
    "dist/usage/usage.js",
    "dist/validation/config.js",
    "schema/**",
    "skills/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist/validation/records.js",
    "dist/packaging/inventory.js",
    "dist/packaging/hosts.js",
    "dist/packaging/install.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:assets": "node --import tsx src/packaging/cli.ts",
    "validate:framework": "node --import tsx src/validation/repository-cli.ts",
    "validate:package": "npm run build && node scripts/check-pack.mjs",
    "check:version": "node --import tsx src/validation/version-cli.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.5"
  }
}
